msgid "plugins.generic.dummyDataGenerator.displayName"
msgstr "Dummy Data Generator"

msgid "plugins.generic.dummyDataGenerator.description"
msgstr "Generate dummy users, submissions, and issues for OJS development and testing."

msgid "plugins.generic.dummyDataGenerator.generateUsers"
msgstr "Generate Users"

msgid "plugins.generic.dummyDataGenerator.generateSubmissions"
msgstr "Generate Submissions"

msgid "plugins.generic.dummyDataGenerator.generateIssue"
msgstr "Generate Issue"

msgid "plugins.generic.dummyDataGenerator.cleanup"
msgstr "Cleanup All Data"

msgid "plugins.generic.dummyDataGenerator.warning"
msgstr "Warning: This will create permanent data in your database. Use only on development/test installations."

msgid "plugins.generic.dummyDataGenerator.cleanupWarning"
msgstr "Warning: This will permanently delete all generated dummy data. This action cannot be undone."

msgid "plugins.generic.dummyDataGenerator.success.usersCreated"
msgstr "Successfully created {$count} users with author role. All passwords set to: DummyUser123!"

msgid "plugins.generic.dummyDataGenerator.success.submissionsCreated"
msgstr "Successfully created {$count} submissions and progressed through workflow to production stage."

msgid "plugins.generic.dummyDataGenerator.success.issueCreated"
msgstr "Issue created and published with all submissions."

msgid "plugins.generic.dummyDataGenerator.success.cleanup"
msgstr "Successfully cleaned up all dummy data."

msgid "plugins.generic.dummyDataGenerator.error.noAuthors"
msgstr "No author users found. Please generate users first."

msgid "plugins.generic.dummyDataGenerator.error.noSubmissions"
msgstr "No submissions found. Please generate submissions first."

msgid "plugins.generic.dummyDataGenerator.error.noContext"
msgstr "No context available. Please access this endpoint from a journal context."

msgid "plugins.generic.dummyDataGenerator.error.noSections"
msgstr "No sections found. Please create at least one section for this journal."

msgid "plugins.generic.dummyDataGenerator.error.invalidCount"
msgstr "Count must be a valid number between 1 and the maximum allowed."

msgid "plugins.generic.dummyDataGenerator.error.confirmationRequired"
msgstr "Confirmation required. Please set 'confirm' parameter to 'DELETE_ALL_DUMMY_DATA'."

msgid "plugins.generic.dummyDataGenerator.error.rateLimited"
msgstr "Rate limited. Please wait {$seconds} seconds before making another request."

msgid "plugins.generic.dummyDataGenerator.error.cleanupFailed"
msgstr "Cleanup failed: {$error}"

msgid "plugins.generic.dummyDataGenerator.error.issueCreationFailed"
msgstr "Failed to create issue: {$error}"

msgid "plugins.generic.dummyDataGenerator.info.passwordNote"
msgstr "Note: All generated users will have the password: DummyUser123!"
