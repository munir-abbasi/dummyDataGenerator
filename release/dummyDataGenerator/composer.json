{
  "name": "munir-abbasi/dummy-data-generator",
  "description": "OJS plugin for generating dummy test data (users, submissions, issues)",
  "type": "ojs-plugin",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "Munir Abbasi",
      "email": "munir@syntaxhouse.com",
      "homepage": "https://syntaxhouse.com"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "APP\\plugins\\generic\\dummyDataGenerator\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "APP\\plugins\\generic\\dummyDataGenerator\\tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --testsuite=Unit",
    "test:integration": "phpunit --testsuite=Integration",
    "test:e2e": "phpunit --testsuite=E2E",
    "test:coverage": "phpunit --coverage-html=coverage/html",
    "phpstan": "phpstan analyse --level=max classes/ api/"
  }
}
